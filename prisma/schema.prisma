generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gadget {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String
  summary   String?
  published Boolean  @default(false)
  parts     Part[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Part {
  id          String     @id @default(cuid())
  gadgetId    String
  gadget      Gadget     @relation(fields: [gadgetId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  function    String
  description String?    @db.Text
  accentColor String     @default("#4f8cff")
  sortOrder   Int        @default(0)
  // разлёт: смещение в единицах сцены и окно прогресса 0..1 (stagger)
  explodeX    Float      @default(0)
  explodeY    Float      @default(0)
  explodeZ    Float      @default(0)
  animStart   Float      @default(0)
  animEnd     Float      @default(1)
  hoverScale  Float      @default(1.06)
  specs       PartSpec[]

  @@unique([gadgetId, slug])
  @@index([gadgetId, sortOrder])
}

model PartSpec {
  id        String @id @default(cuid())
  partId    String
  part      Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int    @default(0)

  @@index([partId, sortOrder])
}
